# Cole sua chave da Groq (console.groq.com/keys) depois do sinal de =, sem aspas
GROQ_API_KEY=cole_sua_chave_aqui

# Modelo da ia GROQ
GROQ_MODEL=openai/gpt-oss-120b

# Configurações do Bot do Discord (opcional)
DISCORD_TOKEN=cole_seu_token_do_discord_aqui
SEU_ID_DISCORD=000000000000000000
ID_CANAL_DISCORD=000000000000000000
